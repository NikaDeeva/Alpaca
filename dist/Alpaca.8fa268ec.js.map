    document.querySelector('.benefits__title').textContent = "\u0427\u043E\u043C\u0443 \u0432\u0430\u0440\u0442\u043E \u043F\u0440\u0438\u0434\u0431\u0430\u0442\u0438 \u0430\u043B\u044C\u043F\u0430\u043A\u0443?";
    const benefitsSubtitle = document.querySelectorAll('.benefits__subtitle');
    benefitsSubtitle[0].textContent = "\u0426\u0456\u043D\u043D\u0456 \u0432\u043E\u0432\u043D\u0430";
