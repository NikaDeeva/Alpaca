    whoData[1].textContent = "\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E 25 \u0440\u043E\u043A\u0456\u0432";
    whoData[2].textContent = "\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E 70 \u043A\u0433";
    whoData[3].textContent = "\u0411\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u0441\u0442\u0432\u043E";
    document.querySelector('.owner__title').textContent = "\u0421\u0442\u0430\u043D\u044C \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440\u0435\u043C \u0447\u0443\u0434\u043E\u0432\u043E\u0457 \u0442\u0432\u0430\u0440\u0438\u043D\u043A\u0438!";
